# Copy this file to .streamlit/secrets.toml (local) or paste it in
# Streamlit Community Cloud > App > Settings > Secrets. NEVER put the real key on GitHub.
LLM_PROVIDER = "openai_compat"
LLM_API_KEY = "paste-your-key-here"
LLM_BASE_URL = "https://api.openai.com/v1"   # or the endpoint given by the teacher
LLM_MODEL = "gpt-4o-mini"                    # or the model given by the teacher
LLM_DAILY_LIMIT = "500"                      # max API calls per day
